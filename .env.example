# Server-side connection to the TIS Agent Supabase project.
# Copy to .env and fill from the dashboard. Never put real keys in this file.

SUPABASE_URL=https://ixjsiwedssgutrmegyzv.supabase.co
SUPABASE_SECRET_KEY=
# Must start with sk- (from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# WhatsApp Cloud API (Meta test number for Milestone 3 preview)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Short string you invent — must match Meta webhook Verify token field
WHATSAPP_VERIFY_TOKEN=tis-tina-verify
# Optional for first test; required later for signature checks
WHATSAPP_APP_SECRET=

# Admin app (admin/.env.local) — publishable anon key, not the secret key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ADMIN_EMAILS=staff@school.edu
